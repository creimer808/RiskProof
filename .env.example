# RiskProof configuration
# Copy to `.env` and adjust. Every setting uses the RISKPROOF_ prefix.
# SECURITY: never put real credentials in this file or in `.env` committed to git.

# --- Core -------------------------------------------------------------------
# SQLite database used for findings, investigations, intel cache, and audit log.
RISKPROOF_DB_PATH=~/.riskproof/riskproof.db

# Force fixture-backed intelligence (offline demo mode, clearly labeled).
RISKPROOF_OFFLINE=false

# --- Validation authorization (secure by default) ----------------------------
# Comma-separated allowlist of targets authorized for non-destructive
# validation: hostnames, IP addresses, or CIDR ranges. Empty = refuse all.
RISKPROOF_ALLOWED_TARGETS=127.0.0.1,::1

# Comma-separated approved validation methods. Only these non-destructive
# checks are ever available: tcp_connect, http_banner, tls_cert_dates.
RISKPROOF_APPROVED_VALIDATION_METHODS=tcp_connect,http_banner,tls_cert_dates

# All remediation actions require human approval and run dry-run by default.
RISKPROOF_REQUIRE_APPROVAL=true
RISKPROOF_DRY_RUN=true

# --- Threat intelligence sources ---------------------------------------------
RISKPROOF_EPSS_BASE_URL=https://api.first.org/data/v1/epss
RISKPROOF_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
RISKPROOF_KEV_MAX_AGE_HOURS=24
RISKPROOF_HTTP_TIMEOUT_SECONDS=15

# --- Scan import --------------------------------------------------------------
# Directory import_nessus may read from. The agent supplies only a bare file
# name; it cannot choose another path. Default: ~/.riskproof/imports
# RISKPROOF_IMPORT_DIR=~/.riskproof/imports
# RISKPROOF_MAX_IMPORT_BYTES=536870912

# --- Asset inventory ----------------------------------------------------------
# Operator-maintained business context (criticality, environment, internet
# exposure, owner) applied to real scan findings. JSON; see docs/usage.md.
# Missing file = no inventory. Default: ~/.riskproof/assets.json
# RISKPROOF_ASSET_INVENTORY=~/.riskproof/assets.json

# --- Reports ------------------------------------------------------------------
# Directory where generate_report writes HTML reports (mode 0600). Tool input
# cannot choose output paths; only this operator setting can.
# RISKPROOF_REPORTS_DIR=~/.riskproof/reports

# --- Fixtures ----------------------------------------------------------------
# Directory holding clearly-labeled sample data for offline use.
# Defaults to the bundled ./fixtures directory.
# RISKPROOF_FIXTURES_DIR=./fixtures

# --- Tenable Vulnerability Management (Tenable One) API ------------------------
# import_tenable runs a read-only vulnerability export. API keys are NEVER read
# from this file: set TENABLE_ACCESS_KEY / TENABLE_SECRET_KEY in the MCP
# server's process environment only (e.g. `claude mcp add -e ...` or your
# secret manager). Prefer Tenable's Hexa MCP when the host agent offers it.
# RISKPROOF_TENABLE_BASE_URL=https://cloud.tenable.com   # must be https
# RISKPROOF_TENABLE_EXPORT_TIMEOUT_SECONDS=300
# RISKPROOF_TENABLE_POLL_INTERVAL_SECONDS=3

# --- Import reconciliation ----------------------------------------------------
# After a complete Tenable import, findings no longer reported can be marked
# `not_seen` (opt-in via import_tenable reconcile=True). Skip when more than
# this fraction of in-scope open findings would be flagged (incomplete export?).
# RISKPROOF_RECONCILE_MAX_MISSING_FRACTION=0.5

# --- GreyNoise (optional exploitation signal) ----------------------------------
# The API key is NEVER read from this file: set GREYNOISE_API_KEY in the MCP
# server's process environment only. A free key is enough. Without it
# RiskProof works as before and reports GreyNoise as "not configured".
# RISKPROOF_GREYNOISE_BASE_URL=https://api.greynoise.io   # must be https
# RISKPROOF_GREYNOISE_WINDOW_DAYS=3            # days of activity that count (1-10)
# RISKPROOF_GREYNOISE_MAX_CALLS_PER_RUN=100    # activity requests per run (0 = none)
